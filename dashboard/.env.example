NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# When backend AUTH_DISABLED=true, dashboard uses a local Bearer sub:<id> token.
NEXT_PUBLIC_AUTH_DISABLED=true
NEXT_PUBLIC_DEV_SUBJECT=dashboard-dev

# Auth0 SPA (used when NEXT_PUBLIC_AUTH_DISABLED=false)
NEXT_PUBLIC_AUTH0_DOMAIN=YOUR_TENANT.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=
NEXT_PUBLIC_AUTH0_REDIRECT_URI=http://localhost:3000
