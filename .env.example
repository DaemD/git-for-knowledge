MEMORY_API_KEY=nams_replace-me
MEMORY_ENDPOINT=https://memory.neo4jlabs.com/v1
# Single shared NAMS workspace for all users (MVP)
MEMORY_WORKSPACE_ID=replace-with-active-workspace-uuid

# Railway PostgreSQL control plane
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge

# Auth0 tenant with Google social login
OAUTH_ISSUER_URL=https://YOUR_TENANT.auth0.com/
OAUTH_AUDIENCE=https://YOUR_API_IDENTIFIER
OAUTH_JWKS_URL=
OAUTH_REQUIRED_SCOPES=
PUBLIC_BASE_URL=https://grphly-dev.miless.app

# Dev-only: accept Authorization Bearer tokens shaped as sub:<user-id>
AUTH_DISABLED=false

# Dashboard browser origins (comma-separated) + optional SPA client id for Connect tab
# Include your Railway dashboard URL after deploy, e.g. https://grphly-dashboard-dev.up.railway.app
DASHBOARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DASHBOARD_OAUTH_CLIENT_ID=0duBflkrH7BfwctBStAM8h6AAzAtbexD

# Optional invite emails (Resend). Leave disabled until keys are set.
# INVITE_DOCS_URL is optional and unused in emails.
INVITE_EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=grphly <onboarding@resend.dev>

# Lemon Squeezy billing (optional until configured)
# LEMON_SQUEEZY_API_KEY=...
# LEMON_SQUEEZY_WEBHOOK_SECRET=...
# LEMON_SQUEEZY_STORE_ID=12345
# LEMON_SQUEEZY_VARIANT_ID=67890
# BILLING_LANDING_URL=https://your-landing.example
# TRIAL_DAYS=14

# Optional OpenAI for dashboard Overview / entity briefs (API service only)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

HOST=0.0.0.0
PORT=8000
MCP_BASE_PATH=/mcp
